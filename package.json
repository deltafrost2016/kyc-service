{
  "name": "kyc-service",
  "version": "1.0.0",
  "description": "Async Indian identity document analysis service (Express + Gemini Vision + SQS/SNS + pgvector RAG dedup)",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "migrate": "sequelize-cli db:migrate",
    "migrate:undo": "sequelize-cli db:migrate:undo",
    "migrate:create": "sequelize-cli migration:generate --name",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write .",
    "sam:build": "sam build",
    "generate:env-json": "node scripts/generate-env-json.js",
    "presam:local:api": "npm run generate:env-json",
    "sam:local:api": "sam local start-api --docker-network kyc-service_default --env-vars env.json",
    "presam:local:invoke:dedup": "npm run generate:env-json",
    "sam:local:invoke:dedup": "sam local invoke DedupFunction --docker-network kyc-service_default --env-vars env.json -e events/dedup-sample.json",
    "presam:local:invoke:extract": "npm run generate:env-json",
    "sam:local:invoke:extract": "sam local invoke ExtractFunction --docker-network kyc-service_default --env-vars env.json -e events/extract-sample.json",
    "presam:local:invoke:rules": "npm run generate:env-json",
    "sam:local:invoke:rules": "sam local invoke RulesFunction --docker-network kyc-service_default --env-vars env.json -e events/rules-sample.json",
    "presam:local:invoke:confidence": "npm run generate:env-json",
    "sam:local:invoke:confidence": "sam local invoke ConfidenceFunction --docker-network kyc-service_default --env-vars env.json -e events/confidence-sample.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.0",
    "@aws-sdk/client-s3": "^3.658.0",
    "@aws-sdk/client-sns": "^3.658.0",
    "@aws-sdk/client-sqs": "^3.658.0",
    "@codegenie/serverless-express": "^4.17.1",
    "@google/genai": "^0.3.0",
    "dotenv": "^17.4.2",
    "express": "^4.21.0",
    "google-auth-library": "^9.14.0",
    "openai": "^4.104.0",
    "pg": "^8.13.0",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.2",
    "sequelize": "^6.37.3",
    "tsx": "^4.19.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.162",
    "@types/express": "^4.17.21",
    "@types/node": "^20.16.0",
    "@types/pg": "^8.11.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "esbuild": "^0.28.1",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-airbnb-typescript": "^18.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "prettier": "^3.9.4",
    "sequelize-cli": "^6.6.5",
    "typescript": "^5.6.0",
    "vitest": "^2.1.1"
  }
}
