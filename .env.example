# ---- Runtime ----
NODE_ENV=development
LOG_LEVEL=info
PORT=3000

# ---- Postgres (pgvector) ----
DATABASE_URL=postgres://postgres:postgres@localhost:5432/docanalysis

# ---- AWS / LocalStack ----
# Leave AWS_ENDPOINT_URL unset to target real AWS.
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

ORCHESTRATOR_QUEUE_URL=http://localhost:4566/000000000000/orchestrator-queue
DEDUP_QUEUE_URL=http://localhost:4566/000000000000/dedup-queue
ANALYSE_QUEUE_URL=http://localhost:4566/000000000000/analyse-queue
RULES_QUEUE_URL=http://localhost:4566/000000000000/rules-queue
CONFIDENCE_QUEUE_URL=http://localhost:4566/000000000000/confidence-queue

ANALYSIS_COMPLETE_TOPIC_ARN=arn:aws:sns:ap-south-1:000000000000:analysis-complete
STAGING_BUCKET=doc-staging

# ---- LLM extraction provider ----
# gemini | claude | openai | ollama — only the selected provider's block below is used.
LLM_PROVIDER=gemini

# ---- Gemini (Google AI Studio) ----
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemma-4-31b-it

# ---- Claude (Anthropic) — only when LLM_PROVIDER=claude ----
ANTHROPIC_API_KEY=your-anthropic-api-key
CLAUDE_MODEL=claude-haiku-4-5

# ---- OpenAI — only when LLM_PROVIDER=openai ----
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# ---- Ollama (local) — only when LLM_PROVIDER=ollama ----
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:12b

# ---- Embeddings / RAG dedup ----
# hash  = deterministic local stub (no external calls; good for dev/tests)
# vertex = Vertex AI multimodalembedding@001 (needs GCP creds; 1408 dims)
EMBEDDING_PROVIDER=hash
EMBEDDING_DIM=1408
SIMILARITY_THRESHOLD=0.95

# ---- Vertex (only when EMBEDDING_PROVIDER=vertex) ----
# GCP_PROJECT=my-gcp-project
# GCP_LOCATION=us-central1
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ---- Worker tuning ----
WORKER_WAIT_TIME_SECONDS=20
WORKER_MAX_MESSAGES=5
WORKER_VISIBILITY_TIMEOUT=60
